# ============================================
# OpenClaw-Harness Environment Configuration
# ============================================

# --- Application ---
APP_NAME=OpenClaw-Harness
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-python-secrets
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_EXPIRATION_HOURS=24

# --- Database ---
DATABASE_URL=postgresql+asyncpg://och:och123@localhost:5433/openclaw_harness
# For SQLite (dev): DATABASE_URL=sqlite+aiosqlite:///./och.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6380/0
REDIS_CACHE_TTL=300

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- OpenHarness ---
OPENHARNESS_CONFIG_DIR=~/.och/config
OPENHARNESS_DATA_DIR=~/.och/data
OPENHARNESS_DEFAULT_MODEL=claude-sonnet-4-20250514
OPENHARNESS_MAX_TURNS=8
OPENHARNESS_MAX_TOKENS=4096

# --- LLM Providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenClaw Integration ---
OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
OPENCLAW_SYNC_ENABLED=true
OPENCLAW_API_KEY_PREFIX=och-

# --- Security ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
